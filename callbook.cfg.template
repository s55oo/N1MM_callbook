# Configuration template for the N1MM Contest Callbook (HF variant).
# Copy this file to "callbook.cfg" (same folder as the EXE/script) and
# edit the values you need. The app runs fine with defaults too.

[settings]
# UDP port N1MM Logger+ broadcasts on (External Broadcast -> 12060 default)
udp_port=12060

# Lookups go to QRZCQ.com and HamQTH.com (both free, no account), queried
# in parallel. Results are cached to avoid repeated fetches for the same
# call. cache_days: how many days a cached result stays fresh.
cache_days=30

# JSON file where the cache is stored (relative to this cfg folder). The
# cache is written at most once a minute (and on close), not per lookup.
cache_file=callbook_cache.json

# cache_persist=no keeps the cache in memory only - zero disk writes,
# still de-dupes within the session. Handy for a big multi-thousand-QSO
# contest where you don't need the cache afterwards. Default: yes.
# cache_persist=yes

# cty.dat (AD1C / country-files.com) gives the DXCC country and CQ zone
# offline and instantly. A copy is bundled; a fresh one auto-downloads
# into this folder. cty_update=no disables the download; cty_file points
# at your own copy.
# cty_update=yes
# cty_file=C:\ham\cty.dat

# Optional third source: the PAID QRZ.com XML Callbook Data service for
# HF lookups - use it if you want a third name/state source.
# (https://www.qrz.com/page/xml_data.html). Requires an active QRZ XML
# subscription. Leave empty to keep QRZ out of the lookup chain.
# qrz_username=S55OO
# qrz_password=YOUR_QRZ_PASSWORD