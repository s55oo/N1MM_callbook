# Configuration template for the VHF locator variant.
# Copy this file to "n1mm_VHFcallbook.cfg" (same folder as the EXE/script)
# and edit the values you need. The app runs fine with defaults too.

[settings]
# UDP port N1MM Logger+ broadcasts on (External Broadcast -> 12060 default)
udp_port=12060

# Locator sources (QRZCQ.com, HamQTH.com, QRZ.com public page) are queried
# in parallel and cached. cache_days: how many days an entry stays fresh.
cache_days=30

# JSON file where the cache is stored (relative to this cfg folder). The
# cache is written at most once a minute (and on close), not per lookup.
cache_file=n1mm_VHFcallbook_cache.json

# cache_persist=no keeps the cache in memory only - zero disk writes,
# still de-dupes within the session. Default: yes.
# cache_persist=yes

# VHFCtest4WIN pre-log callsign feed. With vhfctest_share=yes the app also
# listens to VHFCtest4WIN's multi-op sharing broadcasts (UDP 6767) and
# looks up the callsign as you type it, before the QSO is logged - so a
# wrong QRA locator can be caught while it is still editable. Default: no.
# Start the callbook BEFORE VHFCtest4WIN; if VHFCtest4WIN is already
# running it holds the port exclusively and the callbook must be run as
# Administrator (it then reads the broadcasts with a raw capture socket).
# vhfctest_share=no
# vhfctest_port=6767

# Optional third source: the PAID QRZ.com XML Callbook Data service
# (https://www.qrz.com/page/xml_data.html). Requires an active QRZ XML
# subscription. Leave empty to keep QRZ out of the lookup chain.
# qrz_username=S55OO
# qrz_password=YOUR_QRZ_PASSWORD