# Configuration template for VHFcallbook - the merged VHF locator app
# (N1MM Logger+ on UDP 12060 AND VHFCtest4WIN on UDP 6767, one window).
# Copy this file to "VHFcallbook.cfg" (same folder as the EXE/script) and
# edit the values you need. The app runs fine with defaults too.

[settings]
# UDP port N1MM Logger+ broadcasts on (External Broadcast -> 12060 default)
udp_port=12060

# Locator sources (QRZCQ.com, HamQTH.com, QRZ.com public page) are queried
# in parallel and cached. cache_days: how many days an entry stays fresh.
cache_days=30

# JSON file where the cache is stored (relative to this cfg folder). The
# cache is written at most once a minute (and on close), not per lookup.
cache_file=VHFcallbook_cache.json

# cache_persist=no keeps the cache in memory only - zero disk writes,
# still de-dupes within the session. Default: yes.
# cache_persist=yes

# Start-up self-test: on launch each source is queried once and the window
# lists, line by line, whether it answered and how many ms it took.
# selftest=no turns it off. selftest_call sets the test callsign
# (default S55OO; pick any call that all your sources list).
# selftest=yes
# selftest_call=S55OO

# VHFCtest4WIN pre-log callsign feed (UDP 6767). This app listens on 6767
# in ADDITION to the N1MM port by default, so the locator lookup runs as
# you type in VHFCtest4WIN, before the QSO is logged. If VHFCtest4WIN is
# already running it holds 6767 exclusively and the app relaunches itself
# as Administrator (one UAC prompt) to read the broadcast with a raw
# capture socket. Set vhfctest_share=no to turn the 6767 feed - and the
# prompt - off and run as a plain N1MM-only VHF callbook. Default: yes.
# vhfctest_share=yes
# vhfctest_port=6767

# Optional extra source: the PAID QRZ.com XML Callbook Data service
# (https://www.qrz.com/page/xml_data.html). Requires an active QRZ XML
# subscription. Leave empty to keep QRZ out of the lookup chain.
# qrz_username=S55OO
# qrz_password=YOUR_QRZ_PASSWORD
