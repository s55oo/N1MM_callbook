# Configuration template for the N1MM Contest Callbook (HF variant).
# Copy this file to "callbook.cfg" (same folder as the EXE/script) and
# edit the values you need. The app runs fine with defaults too.

[settings]
# UDP port N1MM Logger+ broadcasts on (External Broadcast -> 12060 default)
udp_port=12060

# Lookups go to QRZCQ.com first, then HamQTH.com (both free, no account).
# Results are cached locally to avoid repeated network fetches.
# cache_days: how many days a cached result is considered fresh.
cache_days=30

# JSON file where the local cache is stored (relative to this cfg folder).
cache_file=callbook_cache.json

# Optional third source: the PAID QRZ.com XML Callbook Data service for
# HF lookups - use it if you want a third name/state source.
# (https://www.qrz.com/page/xml_data.html). Requires an active QRZ XML
# subscription. Leave empty to keep QRZ out of the lookup chain.
# qrz_username=S55OO
# qrz_password=YOUR_QRZ_PASSWORD